# Runtime keys and user-specific state. DO NOT COMMIT.
keys.json
/config.json
/config/config.json
!/config/config.example.json
telemetry-bundle.json
# Mutable per-run counter that the Jules workflows rewrite and commit back
# (.github/workflows/autonomous-analysis.yml, autonomous-quota-reset.yml). It is
# a cache, not source: tracking it wrote runtime state into permanent history.
# Both workflows `mkdir -p .jules/state` and tolerate the file being absent
# ("quota-state.json missing — first run. Proceeding."), so an untracked cache is
# the shape they already expect.
.jules/state/quota-state.json
runtime/
logs/
*.log
*.jsonl
node_modules/
dist/
build/out/
.env
.DS_Store
.env*
dist-electron/
release/
.wrangler/
coverage/

# A test must never create a literal "NUL" directory in the repo root
# (Windows device-name hazard — keeps git status clean on Windows).
NUL

# TypeScript build bookkeeping and generated compiler/bundler output
# (build/assets/ stays committed: it holds the checked-in icon sources/PNGs).
*.tsbuildinfo
build/vite.config.js
build/vite.config.d.ts
build/src/
build/renderer/
# Generated gateway engine bundle (scripts/build-gateway-bundle.mjs). Produced by
# `npm run build`; never committed, so the repo keeps exactly one copy of the
# engine — the readable sources in src/gateway.
build/gateway/
