{
  "name": "nv-gateway",
  "version": "0.1.0",
  "description": "Free Windows desktop gateway for NVIDIA NGC/NIM: 100+ models, OpenAI+Anthropic compatible local API, multi-key rotation & failover",
  "author": "HaYkMnE",
  "license": "MIT",
  "homepage": "https://github.com/HaYkMnE/NV-Gateway",
  "repository": { "type": "git", "url": "https://github.com/HaYkMnE/NV-Gateway.git" },
  "bugs": { "url": "https://github.com/HaYkMnE/NV-Gateway/issues" },
  "keywords": ["nvidia","ngc","nim","openai-compatible","anthropic-compatible","ai-gateway","llm-gateway","api-gateway","proxy","failover","electron","windows","desktop-app","llm","claude-code"],
  "main": "build/src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.node.json && tsc --project tsconfig.json --noEmit && vite build && npm run build:gateway",
    "build:gateway": "node scripts/build-gateway-bundle.mjs",
    "build:portable": "npm run build && node scripts/run-electron-builder.mjs --win portable && npm run package:audit",
    "build:release": "npm run build && node scripts/run-electron-builder.mjs --win --publish never && npm run package:audit",
    "start": "electron .",
    "prebuild": "node scripts/clean-node-build.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "package:dir": "npm run build && node scripts/run-electron-builder.mjs --dir && npm run package:audit",
    "package:env-guard": "node scripts/packaging-env-guard.mjs",
    "package:audit": "npm run test:packaged-migration && npm run test:packaged-security && npm run test:packaged-gateway-link && npm run test:packaged-credentials",
    "test:packaged-migration": "node scripts/packaged-migration-smoke.mjs",
    "test:packaged-security": "node scripts/packaged-security-smoke.mjs",
    "test:packaged-gateway-link": "node scripts/packaged-gateway-link-smoke.mjs",
    "test:packaged-credentials": "node scripts/packaged-credential-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@tanstack/react-query": "^5.51.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "0.28.2",
    "i18next": "^23.14.0",
    "js-yaml": "4.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.435.0",
    "postcss": "^8.4.40",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.18.3",
    "resedit": "1.7.2",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "zustand": "^4.5.5"
  }
}
